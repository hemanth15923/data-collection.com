#include <fstream>
#include <iostream>
#include <limits>
#include <string>

using namespace std;

bool fileIsEmpty(const string& filename) {
    ifstream file(filename, ios::ate);

    if (!file.is_open()) {
        return true;
    }

    return file.tellg() == 0;
}

string escapeCsv(const string& value) {
    string result = "\"";

    for (char ch : value) {
        if (ch == '"') {
            result += "\"\"";
        } else {
            result += ch;
        }
    }

    result += "\"";
    return result;
}

